#!/bin/sh
set -eu
appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export FELISMUSIC_HOST_PATH="$PATH"
export PATH="$appdir/usr/bin:$PATH"
# Separate the bundled plugin registry from the system's GStreamer cache.
export GST_REGISTRY="${XDG_CACHE_HOME:-$HOME/.cache}/felismusic/appimage-gstreamer-registry.bin"
mkdir -p -- "$(dirname -- "$GST_REGISTRY")"
exec "$appdir/usr/lib/felismusic/felismusic" "$@"
